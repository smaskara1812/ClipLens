SECRET_KEY=
DEBUG=
ALLOWED_HOSTS=

# ── Site URL — change this to match wherever you deploy ───────────────────────
# Examples:
#   Local dev:       http://localhost:8000
#   Custom port:     http://localhost:5000
#   LAN / IIS:       http://192.168.1.100:8080
#   Production:      https://stream.yourcompany.com
SITE_URL=

# ── Database engine: set exactly one to true ──────────────────────────────────
USE_MYSQL=false
USE_MSSQL=false
USE_POSTGRES=true

# ── Postgres ───────────────────────────────────────────────────────────────────
POSTGRES_DB=freestream
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ── MySQL ─────────────────────────────────────────────────────────────────────
MYSQL_DB_NAME=videos
MYSQL_DB_USER=root
MYSQL_DB_PASSWORD=
MYSQL_DB_HOST=localhost
MYSQL_DB_PORT=3306

# ── MSSQL (SQL Server) ────────────────────────────────────────────────────────
MSSQL_DB_NAME=
MSSQL_DB_USER=
MSSQL_DB_PASSWORD=
MSSQL_DB_HOST=
MSSQL_DB_PORT=1433
# ODBC driver name — run: odbcinst -q -d   to list installed drivers
MSSQL_ODBC_DRIVER=ODBC Driver 17 for SQL Server

# ── Multi-resolution HLS ──────────────────────────────────────────────────────
# true  → encode multiple renditions + master playlist (adaptive bitrate)
# false → single quality encode (faster, less disk space)
HLS_MULTI_QUALITY=true

# Comma-separated target heights to encode.
# Renditions ABOVE the source video height are automatically skipped.
# e.g. a 720p source will only produce 720p, 480p, 360p even if 1080p is listed.
# Available: 2160, 1440, 1080, 720, 480, 360, 240, 144
HLS_QUALITIES=2160,1440,1080,720,480,360,240,144

# HLS segment duration in seconds (applies to all renditions)
# Shorter = faster seek, larger playlist; longer = fewer files, slightly better compression.
# 6s is the standard default.
HLS_SEGMENT_DURATION=6

# ── Embed / iframe permissions ────────────────────────────────────────────────
# Controls which websites are allowed to embed your videos in an <iframe>.
# Use * to allow ALL sites (default — good for internal platforms).
# Or restrict to specific origins (space or comma separated):
# EMBED_ALLOW_ORIGINS=https://lms.essar.com,https://intranet.essar.com
EMBED_ALLOW_ORIGINS=*

# ── Frame analysis ───────────────────────────────────────────────────────────
# Master switch — set to false to skip ALL AI analysis during development
FRAME_ANALYSIS_ENABLED=true
# Enable/disable face detection and identity matching (InsightFace)
FACE_RECOGNITION_ENABLED=true
# Enable/disable natural language scene descriptions (BLIP or Florence-2)
SCENE_DESCRIPTION_ENABLED=true
# Scene caption model: 'blip' (faster, concise) or 'florence2' (richer, slower)
SCENE_CAPTION_MODEL=blip
# Enable/disable CLIP embedding for semantic search
CLIP_ENABLED=true

# ── CLIP similarity thresholds ────────────────────────────────────────────────
# Cosine similarity score (0.0–1.0) above which a frame is returned as a semantic match.
# Lower = more results but more false positives. Higher = fewer, more precise results.
# Video frames: 0.24 is a good balance. Range: 0.20 (loose) – 0.35 (strict).
CLIP_SIMILARITY_THRESHOLD=0.24
# Photos are held to a stricter threshold to reduce cultural association false positives
# (e.g. "cow" matching Bali photos via Hindu context). Range: 0.25–0.40.
CLIP_PHOTO_SIMILARITY_THRESHOLD=0.28

# How often to sample video frames for analysis (1 frame every N seconds).
# Lower = more detail in search, much higher disk/CPU cost. 5s is a good default.
FRAME_INTERVAL_SECONDS=5

# YOLO model variant: yolov8n (fastest/smallest) → yolov8s → yolov8m → yolov8l → yolov8x (slowest/best)
YOLO_MODEL=yolov8n

# ── Fuzzy text search ─────────────────────────────────────────────────────────
# Enable trigram fuzzy matching (pg_trgm) for title, tag, chapter, and label searches.
# Catches typos and partial matches (e.g. "confernce" → "conference").
FUZZY_SEARCH_ENABLED=True
# Trigram similarity score (0.0–1.0) required for a fuzzy match.
# Lower = more typo tolerance but more false positives.
# 0.35 is the recommended minimum. Do NOT go below 0.30 (too many false positives).
# Note: queries ≤ 3 characters skip fuzzy entirely regardless of this setting.
FUZZY_SEARCH_SIMILARITY_THRESHOLD=0.35

# ── Face recognition thresholds ───────────────────────────────────────────────
# Cosine similarity threshold for auto-confirming a face match (0.0–1.0).
# Above this score, the system marks the match as confirmed without manual review.
# Higher = safer (fewer wrong auto-confirmations). Recommended: 0.80–0.88.
FACE_AUTO_CONFIRM_THRESHOLD=0.82

# ── Scene change detection ─────────────────────────────────────────────────────
# When SCENE_CHANGE_ENABLED=true, FFmpeg also extracts a frame at every hard cut
# (pixel-level difference > SCENE_CHANGE_THRESHOLD) in addition to the regular
# FRAME_INTERVAL_SECONDS baseline.  Near-duplicate frames (closer than
# SCENE_CHANGE_MIN_GAP seconds to an already-kept frame) are dropped so a cut
# that lands right on the interval doesn't double-process the same instant.

SCENE_CHANGE_ENABLED=true
# Pixel-level difference threshold for scene changes (0–1).
# Lower = more sensitive; higher = less sensitive. 0.35 is a good default.

SCENE_CHANGE_THRESHOLD=0.35

SCENE_CHANGE_MIN_GAP=0.5

# ── Whisper (auto-captions / transcription) ────────────────────────────────────
# Model size: tiny | base | small | medium | large-v2 | large-v3
# Larger = more accurate but slower and uses more RAM/VRAM.
# Recommended: 'base' for dev, 'small' or 'medium' for production.
WHISPER_MODEL_SIZE=base
# Device: 'cpu' or 'cuda' (requires NVIDIA GPU + CUDA toolkit)
WHISPER_DEVICE=cpu
# Compute type: 'int8' (fast, good for CPU), 'float16' (GPU), 'float32' (slow, any device)
WHISPER_COMPUTE_TYPE=int8

# ── Speaker Diarization (pyannote.audio) ──────────────────────────────────────
# Required ONLY if you use the "Run Diarization" button on videos.
# Steps to get your token:
#   1. Create a free account at https://huggingface.co
#   2. Go to https://hf.co/settings/tokens and create a READ token
#   3. Accept terms at https://hf.co/pyannote/speaker-diarization-3.1
#   4. Paste the token here
# Leave blank to disable the diarization feature.
HF_TOKEN=s
# 1 = offline mode (skip HuggingFace version-check pings — use after models are downloaded)
# 0 = online mode (checks for model updates on each run)
HF_HUB_OFFLINE=1

# ── Audio event detection (PANNs + FFmpeg silencedetect) ─────────────────────
# Non-speech audio tagger (applause, laughter, music, cheering, crowd, booing)
# + silence-span detector.  Runs automatically after speaker diarization and
# powers the third lane on the video X-ray page.  PANNs CNN14 weights (~150 MB)
# auto-download to ~/panns_data/ on the first task run — no preinstall needed.
AUDIO_EVENTS_ENABLED=true
# Celery queue name.  Add this queue to your worker (see start.sh).
AUDIO_EVENTS_QUEUE=audio
# Minimum softmax probability to keep a PANNs class for a window (0.0–1.0).
AUDIO_EVENTS_MIN_CONFIDENCE=0.22
# Drop spans shorter than this (seconds) — kills single-window noise.
AUDIO_EVENTS_MIN_DURATION_SEC=0.35
# Analysis window size + hop (seconds).  1.0 / 0.5 = 50% overlap.
AUDIO_EVENTS_WINDOW_SEC=1.0
AUDIO_EVENTS_HOP_SEC=0.5
# FFmpeg silencedetect thresholds: "quieter than this dB for at least this long" = silence. db decible
AUDIO_EVENTS_SILENCE_DB=-30
AUDIO_EVENTS_SILENCE_MIN_SEC=1.0
# Device for PANNs inference: 'cpu' or 'cuda'.
AUDIO_EVENTS_DEVICE=cpu

# ── Speaker matching thresholds ────────────────────────────────────────────────
# Cosine similarity threshold for cross-video speaker matching (0.0–1.0).
# A new speaker embedding is matched to an existing SpeakerIdentity when
# cosine_sim >= threshold.  0.75 is a good balance for wespeaker-resnet34.
# Raise to 0.85+ if you get false merges; lower to 0.65 if same person
# isn't being matched across videos.
SPEAKER_MATCH_THRESHOLD=0.75

# ── Face recognition settings ─────────────────────────────────────────────────
# Max crop *images* saved per identity per video (keeps storage bounded).
# All DetectedFace rows are still created; only the N most frontal faces get images.
FACE_MAX_CROPS_PER_VIDEO=6
FACE_DENSE_FPS=1
FACE_GRACE_WINDOW=4
FACE_REID_THRESHOLD=0.45

# ── Celery / Redis ────────────────────────────────────────────────────────────
# Redis is used as the Celery task broker (DB 0) and Django cache (DB 1).
REDIS_URL=redis://localhost:6379/1
CELERY_BROKER_URL=redis://localhost:6379/0

# ── Flower task monitor ───────────────────────────────────────────────────────
# Basic auth credentials for the Flower dashboard at /flower/ (or port 5556 locally).
# Format: username:password
FLOWER_BASIC_AUTH=admin:password

# ── SCENE_CAPTION_MODEL alternatives ─────────────────────────────────────────
# SCENE_CAPTION_MODEL=blip        # fast, clean, concise (default)
# SCENE_CAPTION_MODEL=florence2   # richer but more verbose

# ── Seek / scrub thumbnail sprites ───────────────────────────────────────────
# Master switch — set to false to disable sprite generation entirely.
SEEK_THUMBNAILS_ENABLED=true

# How often to sample frames for the sprite (seconds per tile).
# Lower = more precise scrub preview but larger sprite file.
# Should generally match or be a multiple of FRAME_INTERVAL_SECONDS.
# 5s → ~60 tiles for a 5-min video, ~720 tiles for a 1-hr video.
SEEK_THUMBNAIL_INTERVAL=3

# Dimensions of each tile in the sprite sheet (pixels).
# 160×90 is a standard 16:9 thumbnail at low bandwidth (~40 KB per sprite).
SEEK_THUMBNAIL_WIDTH=160
SEEK_THUMBNAIL_HEIGHT=90

# Number of tile columns in the sprite grid.
# Rows are computed automatically from duration ÷ interval ÷ cols.
SEEK_THUMBNAIL_COLS=25

# FFmpeg JPEG quality (1 = best / largest, 31 = worst / smallest).
# 4 gives good quality at a small file size. Range: 2–8 is sensible.
SEEK_THUMBNAIL_QUALITY=4

# ── FFmpeg paths (only needed if ffmpeg is not on your system PATH) ───────────
# Windows example:
#   FFMPEG_PATH=C:\ffmpeg\bin\ffmpeg.exe
#   FFPROBE_PATH=C:\ffmpeg\bin\ffprobe.exe
# Leave blank to use system PATH
FFMPEG_PATH=
FFPROBE_PATH=
